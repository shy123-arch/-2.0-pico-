[Unit]
Description=HoloTeleop camera streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unitree
WorkingDirectory=/mnt/nexus/workspace/project/HoloTeleop/sim2real/camera_streamer
Environment=CAMERA_INPUT_FORMAT=H264
Environment=CAMERA_WIDTH=720
Environment=CAMERA_HEIGHT=1280
Environment=CAMERA_FPS=30
Environment=CAMERA_CONTROL_PORT=13579
Environment=RECORD_CONTROL_PORT=13600
ExecStart=/bin/bash scripts/start_camera_streamer.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
